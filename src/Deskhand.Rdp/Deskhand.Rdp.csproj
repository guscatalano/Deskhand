<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>deskhand-rdp</AssemblyName>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deskhand.Core\Deskhand.Core.csproj" />
    <!-- ActiveX interop generated from C:\Windows\System32\mstscax.dll via AxImp (see README). -->
    <Reference Include="MSTSCLib"><HintPath>lib\MSTSCLib.dll</HintPath></Reference>
    <Reference Include="AxMSTSCLib"><HintPath>lib\AxMSTSCLib.dll</HintPath></Reference>
  </ItemGroup>

</Project>
